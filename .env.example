# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.
#
# Where the SQLite database and the sample/export/backup folders live.
# Defaults are `data/` under the project root.
# TERMINAL_DATA_DIR=C:\Users\you\Documents\idx-terminal-data
# TERMINAL_DB_PATH=C:\Users\you\Documents\idx-terminal-data\terminal.db

# Optional AI research assistant. The terminal works fully without it.
# Supported providers: openai, openrouter, ollama (local), none.
# AI_PROVIDER=none
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=
#
# The assistant is only ever sent figures that are already computed locally, and
# its reply is checked for numeric fidelity before display. It never has access
# to the database, the filesystem, or the network beyond its own endpoint.
